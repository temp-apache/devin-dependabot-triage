# Copy to .env. The receiver refuses to start if any REQUIRED value is missing.

# ---------------------------------------------------------------- REQUIRED

# owner/name of the repository whose Dependabot PRs get triaged
TARGET_REPO=temp-apache/superset

# GitHub personal access token: https://github.com/settings/tokens
#   classic: `repo` (+ `admin:repo_hook` if scripts/setup_repo.py should create the webhook)
#   fine-grained: Pull requests + Contents read/write on TARGET_REPO (+ Webhooks read/write)
GITHUB_TOKEN=

# Any random string, e.g. `openssl rand -hex 20`. Paste the same value into the
# webhook's "Secret" field on GitHub (Settings -> Webhooks); it is how the receiver
# proves a delivery came from GitHub.
GITHUB_WEBHOOK_SECRET=

# Devin API key: https://app.devin.ai/settings/api-keys  (a service key is fine)
DEVIN_API_KEY=

# ------------------------------------------------- REQUIRED for docker compose locally

# Public channel from https://smee.io/new . The `smee` container relays GitHub webhooks
# to the receiver so nothing has to be deployed or port-forwarded. Not needed on Fly.io
# or anywhere GitHub can reach the receiver directly.
SMEE_URL=

# ---------------------------------------------------------------- OPTIONAL

# true = log what would be posted, touch nothing on GitHub. Start here.
DRY_RUN=false

# 'devin' lets the review session approve and merge; 'service' does it here from the
# structured decision
MERGE_ACTOR=devin

# Devin merges only at or above this confidence
MIN_CONFIDENCE=0.8

# true  = also require a passed Devin Review on the PR before merging (see below)
# false = merge on Devin's verified decision + MIN_CONFIDENCE alone
REQUIRE_DEVIN_REVIEW=false

# Channel named at the end of every decline / escalation, e.g. #engineering.
# Nothing is sent anywhere; leave empty to drop the line.
ESCALATION_CHANNEL=

# Only used when REQUIRE_DEVIN_REVIEW=true. Devin Review does not run on bot PRs by
# itself, so the service requests one and waits for the verdict. Needs an API key that
# is allowed to call /v3/.../pr-reviews (403 otherwise -> fails closed, nothing merges).
# DEVIN_ORG_ID is the org-<uuid> in your app.devin.ai settings URL; leave empty on an
# enterprise account to use the enterprise-scoped route.
TRIGGER_DEVIN_REVIEW=true
DEVIN_ORG_ID=

# PR authors the receiver acts on, as a JSON list. Add your own login to trigger on
# hand-made PRs.
# BOT_SENDERS=["dependabot[bot]"]
