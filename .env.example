# Repository whose Dependabot PRs get triaged
TARGET_REPO=temp-apache/superset

# PAT with repo + security_events (+ admin:repo_hook if you run scripts/setup_repo.py)
GITHUB_TOKEN=

# Any random string; must match the secret configured on the GitHub webhook
GITHUB_WEBHOOK_SECRET=

# https://app.devin.ai/settings/api-keys
DEVIN_API_KEY=

# Public channel from https://smee.io/new -- local development only
SMEE_URL=

# 'devin' lets the review session approve and merge; 'service' does it from the decision
MERGE_ACTOR=devin
REQUIRE_DEVIN_REVIEW=true
MIN_CONFIDENCE=0.8

# true = log what would be posted, touch nothing
DRY_RUN=false
